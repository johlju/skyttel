{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "*.json",
      "*.config.ts",
      "!package-lock.json",
      "!!.agents/skills"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "usePlaywrightValidDescribeCallback": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "tests/integration/**/*.spec.ts",
        "tests/real-*/**/*.spec.ts",
        "tests/technical-browser/**/*.spec.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "usePlaywrightValidDescribeCallback": "error"
          }
        }
      }
    },
    {
      "includes": ["tests/unit/**", "tests/browser/**", "tests/support/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ]
}
