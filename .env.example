# Copy to .env.local. Keep real secrets and identity values out of Git.
SKYTTEL_ORIGIN=http://localhost:3000
SKYTTEL_DATABASE_PATH=./data/skyttel.sqlite
# Choose google or microsoft. The subject is a stable provider ID, not email.
SKYTTEL_FIRST_ADMIN_PROVIDER=google
SKYTTEL_FIRST_ADMIN_SUBJECT=
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Shared development value, including dev:prodlike. Never use in QA/staging/production.
# Operators must replace it there with: node -p 'crypto.randomUUID()'
# Keep stable across ordinary restart and outside the data volume.
SKYTTEL_AUTHORITY_GENERATION=00000000-0000-4000-8000-000000000000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional, server-only. Never use a VITE_ variable for this key.
OPENAI_API_KEY=

# Optional LangSmith tracing. See docs/operations/langsmith-rollout.md.
# Leave these commented out until ready. Uncomment and fill them in .env.local.
# Valid configuration enables sending unless a saved opt-out or suspension exists.
# For npm run dev:all or dev:prodlike, select this private file with:
# export SKYTTEL_DEV_ENV_FILE=.env.local
# Otherwise those commands read .devcontainer/.env, not the root .env files.

# Your region's API base URL, without a trailing slash. This example is US.
# SKYTTEL_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Choose the path that matches your workspace in step 3 of the setup guide.
# Path A (All agents): copy the value after SKYTTEL_LANGSMITH_PROJECT: from
# the lookup under skyttel-dev DEVELOPMENT or skyttel-prod PRODUCTION.
# This is the tracer_session_name value, not that field name or an agent ID.
# Path B (classic projects): use skyttel-dev for development or skyttel-prod
# for production, exactly as written. No agent lookup value is needed.
# The value below is only a Path A development example; replace it for your path.
# SKYTTEL_LANGSMITH_PROJECT=skyttel-dev-development
# Workspace UUID returned by the lookup, not the organization or project UUID.
# SKYTTEL_LANGSMITH_WORKSPACE_ID=
# Secret: for local use, add the real tracing-only key ONLY to .env.local.
# Never put a real key in this template, commit it, or use a VITE_ variable.
# Use a tracing-only runtime key, not the setup PAT. In production, use the
# hosting service's private environment settings instead of a committed file.
# SKYTTEL_LANGSMITH_API_KEY=

PORT=3000
# Direct connections only. Production behind ingress needs a protected header policy.
SKYTTEL_CLIENT_ADDRESS_MODE=direct
