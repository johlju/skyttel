# Copy to .env.local. Keep real secrets and identity values out of Git.
SKYTTEL_ORIGIN=http://localhost:3000
SKYTTEL_DATABASE_PATH=./data/skyttel.sqlite
# Choose google or microsoft. The subject is a stable provider ID, not email.
SKYTTEL_FIRST_ADMIN_PROVIDER=google
SKYTTEL_FIRST_ADMIN_SUBJECT=
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
PORT=3000
