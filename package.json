{
  "name": "skyttel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:all": "node scripts/develop.mjs",
    "dev:prodlike": "node scripts/develop-prodlike.mjs",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:migrate": "tsx scripts/migrate-development-database.ts",
    "auth:upgrade": "node dist/server/upgrade-legacy-login.js",
    "build": "npm run test:env -- sh -c 'tsc -p tsconfig.server.json && vite build'",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:docs": "node scripts/check-docs.mjs && cspell --no-progress --dot '**/*.md'",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "test:env": "python3 scripts/testing/run-with-test-environment.py",
    "test:unit": "npm run test:env -- vitest run",
    "test:unit:coverage": "npm run test:env -- vitest run --coverage",
    "test:gates": "npm run test:env -- node --test --test-concurrency=1 scripts/__tests__/*.test.mjs scripts/release/__tests__/*.test.mjs scripts/security/__tests__/*.test.mjs",
    "test:manual-mapping": "npm run test:env -- node scripts/check-manual-mapping.mjs",
    "test:integration": "npm run test:env -- playwright test",
    "test:real-model": "npm run test:env -- playwright test --config playwright.real-model.config.ts",
    "test:real-voice": "npm run test:env -- playwright test --config playwright.real-voice.config.ts",
    "test:report": "playwright show-report --port 9324",
    "test:container": "npm run test:env -- node scripts/check-container.mjs",
    "test:devcontainer": "npm run test:env -- node scripts/check-devcontainer.mjs",
    "test:installation": "node scripts/security/verify-installation.mjs",
    "measure:map": "npm run build && npm run test:env -- tsx scripts/measure-map.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:docs && npm run test:gates && npm run test:manual-mapping && npm run build && npm run test:unit:coverage",
    "purge:install": "node scripts/purge-install.mjs",
    "test:unit:ci": "npm run test:env -- --ci-fonts vitest run",
    "test:integration:ci": "npm run test:env -- --ci-fonts playwright test"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.12",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-auth": "^1.7.12",
    "better-sqlite3": "13.0.3",
    "hono": "^4.13.13",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sharp": "^0.35.5",
    "three": "0.186.1",
    "undici": "^8.12.3",
    "ws": "^8.22.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cspell/dict-sv": "^2.3.4",
    "@devcontainers/cli": "0.89.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "cspell": "^10.4.0",
    "fflate": "0.8.3",
    "jsdom": "^30.1.3",
    "markdownlint": "^0.42.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "0.18.2"
  },
  "//overrides": {
    "katex": "Pin 0.18.2 to fix GHSA-238p-pmpm-9mq7 (CVE-2026-103923) in markdownlint@0.41.1 -> micromark-extension-math@3.1.0 -> katex; upstream still requires vulnerable ^0.16.0."
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
