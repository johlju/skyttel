{
  "name": "skyttel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:all": "node scripts/develop.mjs",
    "dev:prodlike": "node scripts/develop-prodlike.mjs",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:migrate": "tsx scripts/migrate-development-database.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:docs": "node scripts/check-docs.mjs && cspell --no-progress --dot '**/*.md'",
    "test": "npm run build && npm run test:unit && playwright test",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:gates": "node --test scripts/__tests__/*.test.mjs scripts/release/__tests__/*.test.mjs scripts/security/__tests__/*.test.mjs",
    "test:integration": "playwright test",
    "test:real-model": "playwright test --config playwright.real-model.config.ts",
    "test:real-voice": "playwright test --config playwright.real-voice.config.ts",
    "test:report": "playwright show-report --port 9324",
    "test:container": "node scripts/check-container.mjs",
    "test:devcontainer": "node scripts/check-devcontainer.mjs",
    "test:installation": "node scripts/security/verify-installation.mjs",
    "measure:map": "npm run build && tsx scripts/measure-map.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:docs && npm run test:gates && npm run build && npm run test:unit:coverage && npm run test:integration",
    "purge:install": "node scripts/purge-install.mjs"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.5",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "better-auth": "1.7.5",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.8",
    "openai": "7.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sharp": "0.35.4",
    "three": "0.186.1",
    "ws": "8.21.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cspell/dict-sv": "2.3.2",
    "@devcontainers/cli": "0.89.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "cspell": "10.3.3",
    "fflate": "0.8.3",
    "jsdom": "30.1.0",
    "markdownlint": "0.41.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
