{
  "name": "skyttel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:all": "node scripts/develop.mjs",
    "dev:prodlike": "node scripts/develop-prodlike.mjs",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:migrate": "tsx scripts/migrate-development-database.ts",
    "auth:upgrade": "node dist/server/upgrade-legacy-login.js",
    "build": "npm run test:env -- sh -c 'tsc -p tsconfig.server.json && vite build'",
    "start": "node dist/server/index.js",
    "typecheck": "npm run test:env -- tsc --noEmit",
    "lint": "npm run test:env -- biome check .",
    "lint:fix": "npm run test:env -- biome check --write .",
    "lint:docs": "npm run test:env -- sh -c 'node scripts/check-docs.mjs && cspell --no-progress --dot \"**/*.md\"'",
    "test": "npm run build && npm run test:unit && npm run test:technical-browser && npm run test:integration",
    "test:env": "python3 scripts/testing/run-with-test-environment.py",
    "deps:prepare": "python3 scripts/testing/run-with-test-environment.py --prepare",
    "ci:watch": "node .agents/skills/implement-stack/scripts/watch-ci.mjs",
    "test:investigate": "node scripts/testing/investigation.mjs",
    "test:unit": "npm run test:env -- vitest run",
    "test:unit:coverage": "npm run test:env -- vitest run --coverage",
    "test:gates": "npm run test:env -- --chromium node --test --test-concurrency=1 scripts/__tests__/*.test.mjs scripts/release/__tests__/*.test.mjs scripts/security/__tests__/*.test.mjs",
    "test:manual-mapping": "npm run test:env -- --chromium node scripts/check-manual-mapping.mjs",
    "test:integration": "npm run test:env -- playwright test",
    "test:real-model": "npm run test:env -- playwright test --config playwright.real-model.config.ts",
    "test:real-voice": "npm run test:env -- playwright test --config playwright.real-voice.config.ts",
    "test:report": "playwright show-report --port 9324",
    "test:container": "npm run test:env -- node scripts/check-container.mjs",
    "container:vulnerability:check": "bash scripts/security/check-container-image.sh",
    "test:devcontainer": "npm run test:env -- node scripts/check-devcontainer.mjs",
    "test:installation": "node scripts/security/verify-installation.mjs",
    "measure:map": "npm run build && npm run test:env -- tsx scripts/measure-map.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:docs && npm run test:gates && npm run test:manual-mapping && npm run build && npm run test:unit:coverage && npm run test:technical-browser",
    "purge:install": "node scripts/purge-install.mjs",
    "test:unit:ci": "npm run test:env -- --ci-fonts vitest run",
    "test:integration:ci": "npm run test:env -- --ci-fonts playwright test",
    "test:integration:group": "npm run test:env -- --ci-fonts node scripts/testing/integration-groups.mjs",
    "test:technical-browser": "npm run test:env -- playwright test --config playwright.technical.config.ts",
    "test:technical-browser:ci": "npm run test:env -- --ci-fonts playwright test --config playwright.technical.config.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.28",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "0.22.0",
    "better-auth": "^1.7.28",
    "better-sqlite3": "13.2.0",
    "hono": "^4.13.22",
    "js-tiktoken": "1.0.21",
    "langsmith": "0.14.0",
    "openai": "^7.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "sharp": "^0.35.5",
    "three": "0.187.0",
    "undici": "^8.13.1",
    "ws": "^8.23.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@cspell/dict-sv": "^2.3.4",
    "@devcontainers/cli": "0.91.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.2",
    "@vitest/coverage-v8": "^5.1.2",
    "cspell": "^10.5.2",
    "fflate": "0.8.3",
    "jsdom": "^31.0.1",
    "markdownlint": "^0.42.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "katex": "0.18.2"
  },
  "//overrides": {
    "katex": "Pin 0.18.2 to fix GHSA-238p-pmpm-9mq7 (CVE-2026-103923) in markdownlint -> micromark-extension-math@3.1.0 -> katex; upstream still requires vulnerable ^0.16.0."
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
