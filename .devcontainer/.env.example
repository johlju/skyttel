# Copy to .devcontainer/.env before opening the container.
# Both profiles use that private file. Keep real secrets out of Git.
SKYTTEL_ORIGIN=http://localhost:5173
SKYTTEL_DATABASE_PATH=/data/skyttel.sqlite
HOST=0.0.0.0
PORT=3300

# Generate a private value with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Shared development value, including dev:prodlike. Never use in QA/staging/production.
# Operators must replace it there with: node -p 'crypto.randomUUID()'
# Keep stable across ordinary restart and outside the data volume.
SKYTTEL_AUTHORITY_GENERATION=00000000-0000-4000-8000-000000000000

# Synthetic settings allow local startup; real sign-in needs your own providers.
SKYTTEL_FIRST_ADMIN_PROVIDER=google
SKYTTEL_FIRST_ADMIN_SUBJECT=synthetic-first-administrator
GOOGLE_CLIENT_ID=synthetic-google-client
GOOGLE_CLIENT_SECRET=synthetic-google-secret
MICROSOFT_CLIENT_ID=synthetic-microsoft-client
MICROSOFT_CLIENT_SECRET=synthetic-microsoft-secret
