# Copy to .devcontainer/.env before opening the container.
# Both profiles use that private file. Keep real secrets out of Git.
SKYTTEL_ORIGIN=http://localhost:5173
SKYTTEL_DATABASE_PATH=/data/skyttel.sqlite
HOST=0.0.0.0
PORT=3300

# Generate a private value with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Shared development value, including dev:prodlike. Never use in QA/staging/production.
# Operators must replace it there with: node -p 'crypto.randomUUID()'
# Keep stable across ordinary restart and outside the data volume.
SKYTTEL_AUTHORITY_GENERATION=00000000-0000-4000-8000-000000000000

# Synthetic settings allow local startup; real sign-in needs your own providers.
SKYTTEL_FIRST_ADMIN_PROVIDER=google
SKYTTEL_FIRST_ADMIN_SUBJECT=synthetic-first-administrator
GOOGLE_CLIENT_ID=synthetic-google-client
GOOGLE_CLIENT_SECRET=synthetic-google-secret
MICROSOFT_CLIENT_ID=synthetic-microsoft-client
MICROSOFT_CLIENT_SECRET=synthetic-microsoft-secret

# Optional LangSmith tracing for development. See docs/operations/langsmith-rollout.md.
# Leave these commented out until ready. Uncomment and fill them in .devcontainer/.env.
# Valid configuration enables sending unless a saved opt-out or suspension exists.
# Development commands read this private copy by default, including dev:prodlike.
# Root .env files are not merged; SKYTTEL_DEV_ENV_FILE selects a different file.

# Your region's API base URL, without a trailing slash. This example is US.
# SKYTTEL_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Choose the path that matches your workspace in step 3 of the setup guide.
# Path A (All agents): copy the value after SKYTTEL_LANGSMITH_PROJECT=
# under skyttel-dev DEVELOPMENT in the lookup output. This is the
# tracer_session_name value, not that field name or an agent ID.
# Path B (classic projects): use skyttel-dev exactly as written.
# The value below is only a Path A development example; replace it for your path.
# SKYTTEL_LANGSMITH_PROJECT=skyttel-dev-development
# Operator reference for cleanup; not a secret or a required runtime setting.
# Copy the development project UUID from the setup lookup output.
# Retain it with the workspace and region until cleanup is complete.
# SKYTTEL_LANGSMITH_PROJECT_ID=
# Workspace UUID returned by the lookup, not the organization or project UUID.
# SKYTTEL_LANGSMITH_WORKSPACE_ID=
# Secret: put the real development tracing-only key in the Git-ignored
# .devcontainer/.env, never in this template or a VITE_ variable. Do not commit it.
# Use a tracing-only runtime key, not the setup PAT or production key.
# If selecting .env.local with SKYTTEL_DEV_ENV_FILE, keep the secret there instead.
# SKYTTEL_LANGSMITH_API_KEY=
